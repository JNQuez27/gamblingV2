{
  "expo": {
    "name": "BettingLog",
    "slug": "bettinglog",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "scheme": "bettinglog",
    "splash": {
      "backgroundColor": "#e8f4fd"
    },
    "android": {
      "package": "com.bettinglog.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5FB56E"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      "expo-secure-store",
      "./plugins/withGamblingAppQueries",
      "expo-asset",
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
